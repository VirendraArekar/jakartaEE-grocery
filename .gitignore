# ==============================================================================
# FreshCart Grocery - Master .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System & Editor Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDEs & Editors
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
.springBeans

# ------------------------------------------------------------------------------
# Backend: Java / Maven / Spring Boot
# ------------------------------------------------------------------------------
**/target/
target/
*.jar
*.war
*.ear
*.nar
*.class

# Maven wrapper & temporary files
.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# Crash dumps & JVM logs
hs_err_pid*
replay_pid*

# ------------------------------------------------------------------------------
# Frontend: Node.js / Next.js / TypeScript
# ------------------------------------------------------------------------------
**/node_modules/
node_modules/
jspm_packages/

# Next.js build outputs
**/.next/
.next/
out/
build/
dist/

# TypeScript cache
*.tsbuildinfo
next-env.d.ts

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.backup

# ------------------------------------------------------------------------------
# Docker & Local Data Persistence
# ------------------------------------------------------------------------------
data/
*.log
docker-compose.override.yml
.docker/

# ------------------------------------------------------------------------------
# Kubernetes & Security Certificates
# ------------------------------------------------------------------------------
*.key
*.pem
*.crt
*.pfx
*.p12
k8s/secrets.local.yaml

